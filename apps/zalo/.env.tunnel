# `npm run deploy:tunnel`: a testing build that calls the local API through the tunnel.
# Default: the ngrok fallback (`npm run tunnel:ngrok`). For the DSM tunnel (`npm run tunnel`), put
# VITE_API_ORIGIN=<your TUNNEL_ORIGIN> in apps/zalo/.env.tunnel.local (git-ignored), which overrides this.
VITE_API_ORIGIN=https://sawfish-dear-heron.ngrok-free.app
