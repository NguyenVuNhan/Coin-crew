# Copy to .env.production: the Worker origin the Mini App calls, e.g. https://coin-crew.<subdomain>.workers.dev
# (`npm run deploy:tunnel` uses .env.tunnel instead.)
VITE_API_ORIGIN=
# In .env: the Zalo Mini App ID, read by zmp-cli (it also writes ZMP_TOKEN there after `npx zmp-cli@4 login`).
APP_ID=2974436365831148474
