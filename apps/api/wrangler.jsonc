{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "coin-crew",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  // Serve on <name>.<subdomain>.workers.dev. No per-version preview URLs: they would hit the live
  // database, and Google sign-in only returns to APP_ORIGIN.
  "workers_dev": true,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fsl",
      // Placeholder for local dev and tests. Deploys swap in the real ID from the D1_DATABASE_ID
      // environment variable (scripts/write-deploy-config.mjs), so it stays out of the repo.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  // The web app (apps/web) builds into ./public.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "triggers": { "crons": ["0 * * * *"] },
  // APP_ORIGIN is set in the Cloudflare dashboard (and in .dev.vars locally); deploys keep it.
  "keep_vars": true
}
