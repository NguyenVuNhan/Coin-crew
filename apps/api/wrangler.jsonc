{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "finance-sheet-lover",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fsl",
      "database_id": "134fdc02-d3db-4af4-9228-f0ecbe9d965a",
      "migrations_dir": "migrations"
    }
  ],
  // The web app (apps/web) builds into ./public.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "triggers": { "crons": ["0 * * * *"] },
  // Production address. Local dev overrides it in apps/api/.dev.vars (see README).
  "vars": { "APP_ORIGIN": "https://finance-sheet-lover.5pmbmt.workers.dev" }
}
